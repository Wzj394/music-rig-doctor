{
  "name": "compose",
  "description": "编曲 / 录音：只听自己，全部关掉对外输出（B1 全灭），避免任何东西漏到会议或直播",
  "match": {
    "mic":    { "kind": "hardware", "index": 0 },
    "daw":    { "kind": "virtual",  "index": 1 },
    "system": { "kind": "virtual",  "index": 0 }
  },
  "routes": {
    "mic":    { "A1": 0, "A2": 0, "A3": 0, "B1": 0, "B2": 0, "Mono": 1 },
    "daw":    { "A1": 1, "A2": 0, "A3": 0, "B1": 0, "B2": 0, "Mono": 0 },
    "system": { "A1": 1, "A2": 0, "A3": 0, "B1": 0, "B2": 0, "Mono": 0 },
    "_other": { "A1": 0, "A2": 0, "A3": 0, "B1": 0, "B2": 0, "Mono": 0 }
  },
  "buses": { "mono": 0 }
}
